{
  "entities": {
    "UserPublic": {
      "title": "UserPublic",
      "description": "Public profile, progression, and social stats for a MASTER PLAY user keyed by permanent Firebase UID.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "masterPlayId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "profilePhoto": {
          "type": "string",
          "maxLength": 2048
        },
        "level": {
          "type": "number"
        },
        "points": {
          "type": "number"
        },
        "stars": {
          "type": "number"
        },
        "followersCount": {
          "type": "number"
        },
        "followingCount": {
          "type": "number"
        },
        "matchesWon": {
          "type": "number"
        },
        "matchesPlayed": {
          "type": "number"
        },
        "certificationStatus": {
          "type": "string",
          "enum": ["non_sètifye", "sètifye"]
        },
        "verified": {
          "type": "boolean"
        },
        "isOnline": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "fullName", "level", "points", "createdAt", "updatedAt"]
    },
    "UserPrivate": {
      "title": "UserPrivate",
      "description": "Isolated PII, phone number, email, and financial balances for a MASTER PLAY user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "masterPlayId": {
          "type": "string",
          "maxLength": 64
        },
        "phoneNumber": {
          "type": "string",
          "maxLength": 40
        },
        "email": {
          "type": "string",
          "maxLength": 160
        },
        "balance": {
          "type": "number"
        },
        "reservedBalance": {
          "type": "number"
        },
        "isMonetized": {
          "type": "boolean"
        },
        "totalEarnings": {
          "type": "number"
        },
        "availableEarnings": {
          "type": "number"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "balance", "updatedAt"]
    },
    "FollowEdge": {
      "title": "FollowEdge",
      "description": "Follower or following relationship edge between two Firebase UIDs.",
      "type": "object",
      "properties": {
        "followerUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "targetUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["followerUid", "targetUid", "createdAt"]
    },
    "UserGameProgress": {
      "title": "UserGameProgress",
      "description": "Per-game 7-level progression, high score, and points earned for a user.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "currentLevel": {
          "type": "number"
        },
        "highScore": {
          "type": "number"
        },
        "totalPoints": {
          "type": "number"
        },
        "completedLevelsCount": {
          "type": "number"
        },
        "sessionPaid": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "gameId", "currentLevel", "highScore", "totalPoints", "updatedAt"]
    },
    "UserTransaction": {
      "title": "UserTransaction",
      "description": "Payment, NatCash deposit/withdrawal, game entry, or competition registration ledger entry.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "referenceId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "type": {
          "type": "string",
          "maxLength": 64
        },
        "amount": {
          "type": "number"
        },
        "status": {
          "type": "string",
          "enum": ["an_atant", "konfime", "refize"]
        },
        "proofImage": {
          "type": "string",
          "maxLength": 2048
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "referenceId", "type", "amount", "status", "createdAt", "updatedAt"]
    },
    "Post": {
      "title": "Post",
      "description": "User publication (text, image, or video) stored in Firestore with media URLs in Firebase Storage.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "authorPhoto": {
          "type": "string",
          "maxLength": 2048
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "description": {
          "type": "string",
          "maxLength": 2000
        },
        "mediaType": {
          "type": "string",
          "enum": ["text", "image", "video", "none"]
        },
        "mediaUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "videoUrl": {
          "type": "string",
          "maxLength": 2048
        },
        "likesCount": {
          "type": "number"
        },
        "commentsCount": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "authorUid", "authorName", "title", "mediaType", "likesCount", "commentsCount", "createdAt", "updatedAt"]
    },
    "PostLike": {
      "title": "PostLike",
      "description": "Like record on a publication.",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "createdAt"]
    },
    "PostComment": {
      "title": "PostComment",
      "description": "Comment on a publication.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorUid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "authorName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "authorUid", "authorName", "text", "createdAt"]
    },
    "GameScore": {
      "title": "GameScore",
      "description": "Score and leaderboard entry for a game played by a user.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "userName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "gameId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "competitionId": {
          "type": "string",
          "maxLength": 128
        },
        "score": {
          "type": "number"
        },
        "pointsEarned": {
          "type": "number"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "userName", "gameId", "score", "createdAt"]
    },
    "GameCatalog": {
      "title": "GameCatalog",
      "description": "MASTER PLAY game metadata and pricing.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "category": {
          "type": "string",
          "maxLength": 64
        },
        "entryFee": {
          "type": "number"
        },
        "isPaid": {
          "type": "boolean"
        },
        "isActive": {
          "type": "boolean"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "title", "entryFee", "isActive", "updatedAt"]
    },
    "Competition": {
      "title": "Competition",
      "description": "MASTER PLAY competition metadata, prizes, schedule, and winner summary.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "status": {
          "type": "string",
          "maxLength": 64
        },
        "entryFee": {
          "type": "number"
        },
        "currentDay": {
          "type": "string",
          "maxLength": 64
        },
        "prizesFirst": {
          "type": "string",
          "maxLength": 120
        },
        "prizesSecond": {
          "type": "string",
          "maxLength": 120
        },
        "prizesThird": {
          "type": "string",
          "maxLength": 120
        },
        "championName": {
          "type": "string",
          "maxLength": 120
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "name", "status", "entryFee", "updatedAt"]
    },
    "CompetitionParticipant": {
      "title": "CompetitionParticipant",
      "description": "Participant registration and score in a competition.",
