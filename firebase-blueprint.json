    },
    "Notification": {
      "title": "Notification",
      "description": "User notification record.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "message": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "read": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "uid", "title", "message", "read", "createdAt"]
    },
    "AdminAuditLog": {
      "title": "AdminAuditLog",
      "description": "Protected admin audit and snapshot metadata.",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "action": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "details": {
          "type": "string",
          "maxLength": 1000
        },
        "actor": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "action", "details", "actor", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserPublic" },
      "description": "Public user profile, level, points, rank stats, and certification state keyed by Firebase UID."
    },
    "/users/{userId}/private/{docId}": {
      "schema": { "$ref": "#/entities/UserPrivate" },
      "description": "Isolated PII (phoneNumber, email) and balance accessible only to owner or admin."
    },
    "/users/{userId}/followers/{followerId}": {
      "schema": { "$ref": "#/entities/FollowEdge" },
      "description": "Followers subcollection for scalable follow graph."
    },
    "/users/{userId}/following/{targetId}": {
      "schema": { "$ref": "#/entities/FollowEdge" },
      "description": "Following subcollection for scalable follow graph."
    },
    "/users/{userId}/gameProgress/{gameId}": {
      "schema": { "$ref": "#/entities/UserGameProgress" },
      "description": "Per-user 7-level game progress and high score history."
    },
    "/users/{userId}/transactions/{txId}": {
      "schema": { "$ref": "#/entities/UserTransaction" },
      "description": "User payment and NatCash transaction history."
    },
    "/posts/{postId}": {
      "schema": { "$ref": "#/entities/Post" },
      "description": "User publications with Firebase Storage media URLs."
    },
    "/posts/{postId}/likes/{userId}": {
      "schema": { "$ref": "#/entities/PostLike" },
      "description": "Likes subcollection per post."
    },
    "/posts/{postId}/comments/{commentId}": {
      "schema": { "$ref": "#/entities/PostComment" },
      "description": "Comments subcollection per post."
    },
    "/scores/{scoreId}": {
      "schema": { "$ref": "#/entities/GameScore" },
      "description": "Game scores and leaderboard records."
    },
    "/games/{gameId}": {
      "schema": { "$ref": "#/entities/GameCatalog" },
      "description": "Game catalog and pricing metadata."
    },
    "/competitions/{competitionId}": {
      "schema": { "$ref": "#/entities/Competition" },
      "description": "Competition definitions, prizes, schedule, and winners."
    },
    "/competitions/{competitionId}/participants/{userId}": {
      "schema": { "$ref": "#/entities/CompetitionParticipant" },
      "description": "Participants registered in a competition."
    },
    "/competitions/{competitionId}/matches/{matchId}": {
      "schema": { "$ref": "#/entities/CompetitionMatch" },
      "description": "VS matches and verified results inside a competition."
    },
    "/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User notifications."
    },
    "/adminAudit/{logId}": {
      "schema": { "$ref": "#/entities/AdminAuditLog" },
      "description": "Admin-only audit and migration logs."
    }
  }
}
